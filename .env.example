# ========================
# Environment Variables
# ========================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=jwt-secret-key-should-be-long-and-random-in-production

# JWT cookie expiry
JWT_EXPIRES_IN=7d

# App URL (used for CORS, Socket.IO client, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standalone Socket.IO server URL (set to Render URL in production)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Resend transactional email (configure only on the server/hosting provider)
RESEND_API_KEY=
EMAIL_FROM="Student Companion <notifications@your-verified-domain.com>"

# Node environment
NODE_ENV=development
